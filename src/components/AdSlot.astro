---
import { SITE } from '../config';

interface Props {
  slot: keyof typeof SITE.adSlots;
}
const { slot } = Astro.props;
const slotId = SITE.adSlots[slot];
const enabled = Boolean(SITE.adsenseClient && slotId);
const showPlaceholder = !enabled && import.meta.env.DEV;
---
{enabled && (
  <div class="ad-slot">
    <ins
      class="adsbygoogle"
      style="display:block;width:100%"
      data-ad-client={SITE.adsenseClient}
      data-ad-slot={slotId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
{showPlaceholder && <div class="ad-slot placeholder">Ad slot: {slot} (only visible in dev)</div>}
