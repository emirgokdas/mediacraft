---
export interface FaqItem { q: string; a: string }
interface Props { items: FaqItem[] }
const { items } = Astro.props;
---
<section class="faq">
  <h2>Frequently asked questions</h2>
  {items.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
</section>
